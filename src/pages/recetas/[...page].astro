---
import type { GetStaticPaths } from "astro";
import MainLayout from "../../layouts/MainLayout.astro";
import PostListing from "../../components/PostListing.astro";
import { PAGE_SIZE } from "../../consts";
import { getPostsByType } from "../../utils";
import cta1 from "../../assets/cta-index-1.avif";

export const getStaticPaths = (async ({ paginate }) => {
  const filteredPosts = await getPostsByType("receta");
  return paginate(filteredPosts, { pageSize: PAGE_SIZE });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<MainLayout title="Recetas">
  <PostListing
    page={page}
    eyebrow="Recetas"
    title="Recetas"
    description="Recetas caseras con ingredientes fáciles de encontrar, probadas una y otra vez a mi ritmo."
    heading="Lo más reciente entre las recetas"
    image={cta1}
  />
</MainLayout>
