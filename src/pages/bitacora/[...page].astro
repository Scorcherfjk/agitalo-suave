---
import type { GetStaticPaths } from "astro";
import MainLayout from "../../layouts/MainLayout.astro";
import PostListing from "../../components/PostListing.astro";
import { PAGE_SIZE } from "../../consts";
import { getPostsByType } from "../../utils";
import cta2 from "../../assets/cta-index-2.avif";

export const getStaticPaths = (async ({ paginate }) => {
  const filteredPosts = await getPostsByType("bitacora");
  return paginate(filteredPosts, { pageSize: PAGE_SIZE });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<MainLayout title="Bitácora">
  <PostListing
    page={page}
    eyebrow="Bitácora"
    title="Bitácora"
    description="Apuntes de cursos, errores que enseñan y momentos detrás de la barra que merecen ser contados."
    heading="Las aventuras más recientes"
    image={cta2}
  />
</MainLayout>
