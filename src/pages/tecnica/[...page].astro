---
import type { GetStaticPaths } from "astro";
import MainLayout from "../../layouts/MainLayout.astro";
import PostListing from "../../components/PostListing.astro";
import { PAGE_SIZE } from "../../consts";
import { getPostsByType } from "../../utils";
import cta1 from "../../assets/cta-index-1.avif";

export const getStaticPaths = (async ({ paginate }) => {
  const filteredPosts = await getPostsByType("tecnica");
  return paginate(filteredPosts, { pageSize: PAGE_SIZE });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<MainLayout title="Técnica">
  <PostListing
    page={page}
    eyebrow="Técnica"
    title="Técnica"
    description="Vasos, ingredientes, infusiones y los porqués detrás de cada mezcla. Más allá del shaker."
    heading="Más allá del shaker"
    image={cta1}
  />
</MainLayout>
