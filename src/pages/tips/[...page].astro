---
import type { GetStaticPaths } from "astro";
import MainLayout from "../../layouts/MainLayout.astro";
import PostListing from "../../components/PostListing.astro";
import { PAGE_SIZE } from "../../consts";
import { getPostsByType } from "../../utils";
import cta2 from "../../assets/cta-index-2.avif";

export const getStaticPaths = (async ({ paginate }) => {
  const filteredPosts = await getPostsByType("tip");
  return paginate(filteredPosts, { pageSize: PAGE_SIZE });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<MainLayout title="Tips">
  <PostListing
    page={page}
    eyebrow="Tips"
    title="Tips"
    description="Consejos prácticos para mejorar tus tragos en casa, sin equipos caros ni complicaciones."
    heading="Los tips más recientes"
    image={cta2}
  />
</MainLayout>
