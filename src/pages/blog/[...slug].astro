---
import type { GetStaticPaths } from "astro";
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import BlogLayout from "../../layouts/BlogLayout.astro";
import { formatDate, getReadingTime } from "../../utils";
import Alert from "../../components/Alert.astro";
import BlogEntries from "../../components/BlogEntries.astro";
import ShareButtons from "../../components/ShareButtons.astro";

export const getStaticPaths = (async () => {
  const blogPosts = await getCollection("blog");
  return blogPosts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { title, imageUrl, date, updated, excerpt, tags, draft, type } = post.data;
const headerImage = post.data.headerImage ?? imageUrl;

const typeLabel: Record<string, string> = {
  receta: "Receta",
  bitacora: "Bitácora",
  tecnica: "Técnica",
  tip: "Tip",
};

const categoryLinks: Record<string, { label: string; url: string }> = {
  recetas: { label: "Recetas", url: "/recetas" },
  bitacora: { label: "Bitácora", url: "/bitacora" },
  tecnicas: { label: "Técnicas", url: "/tecnica" },
  tips: { label: "Tips", url: "/tips" },
};

const [category] = post.id.split("/");
const categoryLink = categoryLinks[category];

const readingTime = getReadingTime(post.body);

const jsonLd =
  type === "receta" && post.data.ingredients?.length && post.data.steps?.length
    ? JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Recipe",
        name: title,
        description: excerpt,
        image: [headerImage],
        url: new URL(`/blog/${post.id}`, Astro.site).toString(),
        datePublished: date.toISOString(),
        dateModified: updated.toISOString(),
        author: { "@type": "Person", name: "Agítalo Suave" },
        recipeCategory: "Cóctel",
        recipeCuisine: "Cócteles",
        recipeIngredient: post.data.ingredients,
        recipeInstructions: post.data.steps.map((step) => ({
          "@type": "HowToStep",
          text: step,
        })),
        keywords: tags.join(", "),
      })
    : undefined;

const { Content } = await render(post);
---

<BlogLayout
  title={title}
  description={excerpt}
  tags={tags}
  imageUrl={headerImage}
  jsonLd={jsonLd}
>
  <section class="no-print relative overflow-hidden">
    <Image
      src={headerImage}
      alt=""
      class="absolute inset-0 h-full w-full object-cover object-center"
      width={1600}
      height={600}
      fit="cover"
      quality="high"
      loading="eager"
    />
    <div
      class="absolute inset-0 bg-gradient-to-t from-gray-900/95 via-gray-900/55 to-gray-900/25"
    />
    <div
      class="relative mx-auto max-w-screen-xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28"
    >
      <div class="flex items-start justify-between gap-4">
        <nav aria-label="Migas de pan">
          <ol class="flex flex-wrap items-center gap-1.5 text-sm text-rose-200">
            <li>
              <a href="/" class="transition hover:text-white">Inicio</a>
            </li>
            <li aria-hidden="true">/</li>
            <li>
              <a
                href={categoryLink?.url ?? "/blog"}
                class="transition hover:text-white"
              >
                {categoryLink?.label ?? "Blog"}
              </a>
            </li>
            <li aria-hidden="true">/</li>
            <li>
              <span class="text-white/90">{title}</span>
            </li>
          </ol>
        </nav>

        <button
          id="print-button"
          type="button"
          class="no-print inline-flex shrink-0 items-center gap-2 rounded-sm bg-white/10 px-3 py-2 text-sm font-medium text-white backdrop-blur transition hover:bg-white/25"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            class="size-4"
            aria-hidden="true"
          >
            <path d="M6 9V2h12v7" />
            <path d="M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2" />
            <rect x="6" y="14" width="12" height="8" />
          </svg>
          Imprimir
        </button>
      </div>

      <p
        class="mt-8 text-sm font-semibold uppercase tracking-widest text-rose-200"
      >
        {typeLabel[type]}
      </p>

      <h1
        class="mt-2 max-w-3xl text-4xl font-bold tracking-tight text-white sm:text-5xl"
      >
        {title}
      </h1>

      <div class="mt-4 flex flex-wrap items-center gap-2 text-sm text-gray-200">
        <time>{formatDate(date)}</time>
        <span>· {readingTime} min de lectura</span>
        {
          date.getTime() !== updated.getTime() && (
            <span>· Actualizado el {formatDate(updated)}</span>
          )
        }
      </div>
    </div>
  </section>

  <article class="bg-background">
    <div class="mx-5">
      {
        draft && (
          <Alert
            title="En Construccion"
            description="Esta página no ha sido completada, por lo que la información puede presentar errores"
          />
        )
      }

      <Content />

      <div class="mx-auto max-w-prose">
        <ShareButtons title={title} />
      </div>
    </div>
  </article>
  <BlogEntries max={4} />
</BlogLayout>

<script>
  document
    .getElementById("print-button")
    ?.addEventListener("click", () => window.print());
</script>
