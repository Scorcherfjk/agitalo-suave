---
import type { GetStaticPaths } from "astro";
import MainLayout from "../../layouts/MainLayout.astro";
import PostListing from "../../components/PostListing.astro";
import { PAGE_SIZE } from "../../consts";
import { getPostsByType } from "../../utils";

export const getStaticPaths = (async ({ paginate }) => {
  const sortedBlogPosts = await getPostsByType();
  return paginate(sortedBlogPosts, { pageSize: PAGE_SIZE });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<MainLayout title="Blog">
  <PostListing
    page={page}
    eyebrow="Blog"
    title="El blog"
    description="Recetas, bitácora, técnica y tips para explorar la coctelería casera a tu ritmo."
    heading="Lo más reciente en el blog"
  />
</MainLayout>
