---
import "../styles/global.css";
import "../styles/blog.css";

import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";
import Analytics from "../components/layout/Analytics.astro";
import BaseHead from "./BaseHead.astro";


interface Props {
  title: string;
  tags: string[];
  imageUrl: string;
  description: string;
  jsonLd?: string;
  breadcrumbJsonLd?: string;
}

const { title, description, tags, imageUrl, jsonLd, breadcrumbJsonLd } =
  Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <Analytics />
    <BaseHead
      title={title}
      description={description}
      imageUrl={imageUrl}
      tags={tags}
    />
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
    {breadcrumbJsonLd && (
      <script type="application/ld+json" set:html={breadcrumbJsonLd} />
    )}
  </head>
  <body>
    <Navbar />
    <slot />
    <Footer />
  </body>
</html>
