---
import { Image } from "astro:assets";
import { formatDate } from "../utils";
import type { CollectionEntry } from "astro:content";
import Badge from "./Badge.astro";

export interface Props {
  post: CollectionEntry<"blog">;
}

const {
  post: { data, id },
} = Astro.props;
const { title, imageUrl, date, excerpt, tags } = data;
const hasComparative = tags.includes("comparativo");
---

<section
  class="overflow-hidden rounded-lg shadow-sm transition hover:shadow-lg bg-background relative"
>
  <a href={`/blog/${id}`} aria-label={title}>
    {hasComparative && <Badge label="Comparativo" />}

    <Image
      alt={title}
      src={imageUrl}
      class="h-56 w-full object-cover"
      width={640}
      height={480}
      fit="cover"
      quality="high"
    />

    <div class="bg-background p-4 sm:p-6">
      <time class="block text-xs text-gray-500 dark:text-gray-400">
        {formatDate(date)}
      </time>

      <h3 class="mt-0.5 text-lg text-primary">{title}</h3>

      {
        excerpt && (
          <p class="mt-2 line-clamp-3 text-sm/relaxed text-gray-500 dark:text-gray-400">
            {excerpt}
          </p>
        )
      }
    </div>
  </a>
</section>
