---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import heroImage from "../assets/hero.avif";

interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
  image?: ImageMetadata;
}

const { title, description, eyebrow, image = heroImage } = Astro.props;
---

<section class="relative overflow-hidden">
  <Image
    src={image}
    alt=""
    class="absolute inset-0 h-full w-full object-cover"
    width={1600}
    height={600}
    quality="high"
    loading="eager"
  />
  <div
    class="absolute inset-0 bg-gradient-to-r from-gray-900/90 via-gray-900/70 to-gray-900/40"
  />
  <div class="relative mx-auto max-w-screen-xl px-4 py-14 sm:px-6 lg:px-8 lg:py-20">
    <div class="max-w-2xl">
      {
        eyebrow && (
          <p class="text-sm font-semibold uppercase tracking-widest text-rose-200">
            {eyebrow}
          </p>
        )
      }
      <h1
        class="mt-2 text-4xl font-bold tracking-tight text-white sm:text-5xl"
      >
        {title}
      </h1>
      {
        description && <p class="mt-4 text-lg text-gray-200">{description}</p>
      }
    </div>
  </div>
</section>
