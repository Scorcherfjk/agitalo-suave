---
import { Icon } from "astro-icon/components";
import NewsletterForm from "../NewsletterForm.astro";
import { SOCIAL_LINKS, FOOTER_LINKS } from "../../consts";

const year = new Date().getFullYear();
---

<footer class="bg-footer">
  <div
    class="mx-auto max-w-screen-xl space-y-8 px-4 py-16 sm:px-6 lg:space-y-16 lg:px-8"
  >
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-3">
      <div>
        <div class="text-white">
          <p class="text-sm font-semibold">
            <span class="text-4xl capitalize font-cursive">Agítalo Suave</span>
            <br />
            <span class="italic"
              >Explorando el mundo de los cócteles, a mi ritmo</span
            >
          </p>
          <p class="mt-5 font-thin">
            Este sitio está dirigido a personas mayores de edad. El contenido
            relacionado con bebidas alcohólicas es solo para fines informativos
            y recreativos. Por favor, bebe con responsabilidad. <strong
              >El consumo de alcohol es perjudicial para la salud.</strong
            >
          </p>
        </div>
        <ul class="mt-8 flex gap-6">
          {
            SOCIAL_LINKS.map((link) => (
              <li>
                <a
                  href={link.url}
                  rel="noreferrer"
                  target="_blank"
                  class="text-white transition hover:text-rose-200"
                >
                  <span class="sr-only">{link.label}</span>
                  <Icon name={link.icon} class="size-6" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div
        class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:col-span-2 lg:grid-cols-4"
      >
        <div></div>
        {
          FOOTER_LINKS.map((link) => (
            <div>
              <p class="font-medium text-white">{link.title}</p>

              <ul class="mt-6 space-y-4 text-sm">
                {link.children.map((child) => (
                  <li>
                    <a
                      href={child.url}
                      class="text-white transition hover:text-rose-200 block"
                    >
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div
      class="flex flex-col gap-8 lg:flex-row lg:items-center lg:justify-between"
    >
      <p class="max-w-md text-xs text-white">
        &copy; {year}. Made with ❤️ by an enthusiastic bartender
      </p>
      <div class="lg:max-w-md">
        <NewsletterForm compact />
      </div>
    </div>
  </div>
</footer>
