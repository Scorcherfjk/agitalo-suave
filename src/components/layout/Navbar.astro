---
import { Icon } from "astro-icon/components";

const links = [
  { url: "/recetas", text: "Recetas" },
  { url: "/bitacora", text: "Bitácora" },
  { url: "/acerca", text: "Acerca de" },
];

const { pathname } = Astro.url;

const isActive = (url: string) =>
  pathname === url || pathname.startsWith(`${url}/`);
---

<header class="relative bg-background">
  <div class="mx-auto max-w-screen-xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between">
      <div class="md:flex md:items-center md:gap-12">
        <a class="flex items-center gap-2 text-primary" href="/">
          <span class="sr-only">Agítalo Suave</span>
          <Icon name="logo" class="h-9 w-auto md:h-10" />
          <span class="font-cursive text-2xl capitalize leading-none md:text-3xl font-extrabold">
            Agítalo Suave
          </span>
        </a>
      </div>

      <nav aria-label="Principal" class="hidden md:block">
        <ul class="flex items-center gap-6 text-sm">
          {
            links.map((link) => (
              <li>
                <a
                  href={link.url}
                  aria-current={isActive(link.url) ? "page" : undefined}
                  class="text-primary transition hover:text-primary/75"
                >
                  {link.text}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex items-center gap-2">
        <button
          type="button"
          id="theme-toggle"
          aria-label="Cambiar tema claro u oscuro"
          class="rounded-sm bg-background-alt p-2 text-primary transition hover:text-primary/75"
        >
          <svg
            id="theme-toggle-moon"
            xmlns="http://www.w3.org/2000/svg"
            class="size-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
          </svg>
          <svg
            id="theme-toggle-sun"
            xmlns="http://www.w3.org/2000/svg"
            class="size-5 hidden"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
          </svg>
        </button>

        <button
          type="button"
          id="menu-toggle"
          aria-label="Abrir menú de navegación"
          aria-controls="mobile-menu"
          aria-expanded="false"
          class="rounded-sm bg-background-alt p-2 text-primary transition hover:text-primary/75 md:hidden"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="size-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <nav
    id="mobile-menu"
    aria-label="Menú móvil"
    aria-hidden="true"
    class="absolute top-full left-0 z-10 hidden w-full bg-background px-4 py-4 shadow-md"
  >
    <ul class="flex flex-col text-sm">
      {
        links.map((link) => (
          <li>
            <a
              href={link.url}
              class="block w-full py-2 pl-2 text-primary"
            >
              {link.text}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("#menu-toggle");
  const menu = document.querySelector<HTMLElement>("#mobile-menu");

  function setMenu(open: boolean) {
    if (!toggle || !menu) return;
    menu.classList.toggle("hidden", !open);
    menu.setAttribute("aria-hidden", String(!open));
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute(
      "aria-label",
      open ? "Cerrar menú de navegación" : "Abrir menú de navegación",
    );
  }

  toggle?.addEventListener("click", () => {
    setMenu(toggle.getAttribute("aria-expanded") !== "true");
  });

  menu?.addEventListener("click", (event) => {
    if (event.target instanceof HTMLAnchorElement) setMenu(false);
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") setMenu(false);
  });

  const themeToggle =
    document.querySelector<HTMLButtonElement>("#theme-toggle");
  const sunIcon = themeToggle?.querySelector("#theme-toggle-sun");
  const moonIcon = themeToggle?.querySelector("#theme-toggle-moon");

  function setThemeIcon() {
    const dark = document.documentElement.classList.contains("dark");
    sunIcon?.classList.toggle("hidden", !dark);
    moonIcon?.classList.toggle("hidden", dark);
  }

  themeToggle?.addEventListener("click", () => {
    const dark = document.documentElement.classList.toggle("dark");
    try {
      localStorage.setItem("theme", dark ? "dark" : "light");
    } catch {
      /* noop */
    }
    setThemeIcon();
  });

  window
    .matchMedia("(prefers-color-scheme: dark)")
    .addEventListener("change", (event) => {
      let hasStored = false;
      try {
        hasStored = Boolean(localStorage.getItem("theme"));
      } catch {
        /* noop */
      }
      if (hasStored) return;
      document.documentElement.classList.toggle("dark", event.matches);
      setThemeIcon();
    });

  setThemeIcon();
</script>
