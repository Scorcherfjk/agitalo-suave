---
import { Icon } from "astro-icon/components";

interface Props {
  title: string;
}

const { title } = Astro.props;
const url = Astro.url.href;
const text = encodeURIComponent(`${title} · Agítalo Suave`);
const encodedUrl = encodeURIComponent(url);

const shareLinks = [
  {
    name: "Compartir en X (Twitter)",
    href: `https://twitter.com/intent/tweet?text=${text}&url=${encodedUrl}`,
    classes: "bg-black hover:opacity-80",
  },
  {
    name: "Compartir en Facebook",
    href: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`,
    classes: "bg-[#1877f2] hover:opacity-80",
  },
  {
    name: "Compartir en WhatsApp",
    href: `https://wa.me/?text=${text}%20${encodedUrl}`,
    classes: "bg-[#25d366] hover:opacity-80",
  },
];
---

<div class="mt-8 border-t border-gray-200 pt-6 no-print dark:border-gray-700">
  <p class="text-sm font-medium text-gray-600 dark:text-gray-300">¿Te gustó la receta? Compártela:</p>
  <div class="mt-3 flex flex-wrap gap-2">
    {
      shareLinks.map((link) => (
        <a
          href={link.href}
          target="_blank"
          rel="noreferrer"
          aria-label={link.name}
          class={`inline-flex items-center gap-2 rounded-full px-4 py-2 text-sm font-medium !text-white !hover:no-underline transition ${link.classes}`}
        >
          {
            link.name.includes("X") ? (
              <svg viewBox="0 0 24 24" fill="currentColor" class="size-4" aria-hidden="true">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
              </svg>
            ) : link.name.includes("Facebook") ? (
              <Icon name="facebook" class="size-4" />
            ) : (
              <svg viewBox="0 0 24 24" fill="currentColor" class="size-4" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
              </svg>
            )
          }
          {link.name.includes("X") ? "X" : link.name.includes("Facebook") ? "Facebook" : "WhatsApp"}
        </a>
      ))
    }
    <button
      id="copy-link-button"
      type="button"
      class="inline-flex items-center gap-2 rounded-full bg-gray-200 px-4 py-2 text-sm font-medium text-gray-700 transition hover:bg-complementary hover:text-white dark:bg-gray-700 dark:text-gray-200 dark:hover:text-black"
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        class="size-4"
        aria-hidden="true"
      >
        <rect x="9" y="9" width="13" height="13" rx="2" />
        <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1" />
      </svg>
      <span id="copy-link-label">Copiar enlace</span>
    </button>
  </div>
</div>

<script>
  const button = document.getElementById("copy-link-button");
  button?.addEventListener("click", async () => {
    const label = document.getElementById("copy-link-label");
    try {
      await navigator.clipboard.writeText(window.location.href);
      if (label) label.textContent = "¡Copiado!";
      setTimeout(() => {
        if (label) label.textContent = "Copiar enlace";
      }, 2000);
    } catch {
      if (label) label.textContent = "No se pudo copiar";
    }
  });
</script>
